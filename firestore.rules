rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.is_active == true;
    }

    // Users collection: Customers can read and update permitted profile fields of their own record
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Direct client creation/update is restricted; server handles provisioning
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'kyc_tier', 'created_at']);
      allow delete: if false;
    }

    // Wallets collection: Strictly SERVER-ONLY for mutations. Customers may read own wallet.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // All financial mutations executed via server Admin SDK

      // Subcollection: Immutable ledger
      match /ledger/{ledgerId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Append-only via server mutation engine
      }
    }

    // Transactions: Customers can read own transactions; write is server-only
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Service Orders & Order Extensions: Read own; write is server-only
    match /serviceOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /airtimeOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /dataOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /billOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Service Products: Authenticated users can read catalog; write is server-only
    match /serviceProducts/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Payment Attempts: Read own; write is server-only
    match /paymentAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Notifications: Read and mark read on own notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read', 'read_at']);
      allow create, delete: if false;
    }

    // Admin Users collection: Read-only for active admins; writes strictly server-only
    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // KYC Verifications: Customers read own verification state; writes strictly server-only
    match /kycVerifications/{kycId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Audit Logs: Read-only for active admins/auditors; write is server-only
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Idempotency Keys: Strictly server-only
    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    // Providers & System Config: Read-only for active admins; writes strictly server-only
    match /providers/{providerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /providerTransactions/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
