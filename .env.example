# ==============================================================================
# SUPREME DIGITAL NETWORK — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Security Invariant: Never commit live secrets or sensitive credentials.
# Duplicate this file to .env.local for local offline development.
#
# ------------------------------------------------------------------------------
# A. AUTOMATICALLY SUPPLIED GOOGLE / FIREBASE RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# In Google AI Studio, Google Cloud Run, and Firebase App Hosting environments,
# the following are resolved automatically by the runtime infrastructure:
# - Application Default Credentials (ADC) for Firebase Admin SDK
# - Google Cloud Project ID (GOOGLE_CLOUD_PROJECT / GCLOUD_PROJECT)
# - Direct Firebase Web SDK configuration (injected via platform/window context)
# - Port and host binding (PORT=3000 / K_SERVICE)
# No manual entry of Firebase credentials is required in Google AI Studio.

# ------------------------------------------------------------------------------
# B. OPTIONAL LOCAL-DEVELOPMENT OVERRIDES (Offline / External Non-GCP Only)
# ------------------------------------------------------------------------------
# Uncomment and populate ONLY when developing locally without Google Cloud ADC:
# FIREBASE_PROJECT_ID="kanti-aiweb"
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# Optional local client configuration overrides:
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# C. SERVER-ONLY THIRD-PARTY SECRETS (Required for Live External Gateways)
# ------------------------------------------------------------------------------
# Paystack Live Integration (Server-Side Only — NEVER expose to browser)
# Webhook verification uses PAYSTACK_SECRET_KEY via HMAC-SHA512.
# PAYSTACK_SECRET_KEY=""

# Telecom & Utility Aggregators (Server-Side Only)
# VTPASS_API_KEY=""
# VTPASS_SECRET_KEY=""
# VTPASS_PUBLIC_KEY=""
# CLUBKONNECT_USER_ID=""
# CLUBKONNECT_API_KEY=""

# ------------------------------------------------------------------------------
# D. OPTIONAL SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Transactional Communications (Server-Side Only)
# RESEND_API_KEY=""
# SYSTEM_EMAIL_SENDER="Supreme Digital Network <noreply@supreme-digital-networks.ai.studio>"
